--- a/packages/PyTrilinos2/scripts/PyTrilinos2_config.cfg
+++ b/packages/PyTrilinos2/scripts/PyTrilinos2_config.cfg
@@ -35,6 +35,7 @@
 # Teuchos
 +namespace Teuchos
 +include <Teuchos_RCP.hpp>
++include <Teuchos_StackedTimer.hpp>
 
 +include_for_namespace Teuchos <PyTrilinos2_Teuchos_Custom.hpp>
 +add_on_binder_for_namespace Teuchos def_Teuchos_functions
